{
  "name": "steno-drills",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Steno practice that grows with the chords you know.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "data:update": "node scripts/update-sources.mjs",
    "data:build": "node --import tsx scripts/build-dictionary.ts",
    "data:check": "node --import tsx scripts/build-dictionary.ts --check",
    "predev": "npm run data:build",
    "build": "npm run data:build && tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run data:build && npm run typecheck && npm test && npm run data:check",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.3"
  }
}
